# Aqua System – statikus weboldal megosztott (Apache / LiteSpeed) tárhelyen.
# A build a teljes oldalt sima HTML fájlokként teszi az out/ mappába; ez a
# fájl onnan kerül fel a tárhely gyökerébe (public_html).
#
# Szándékosan csak olyan beállítás van itt, ami a legtöbb tárhelyen engedélyezett:
# egy nem engedélyezett sor 500-as hibát adna az egész oldalra.

DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # A régi (2012-es WordPress) oldal címei. Tizenkét éve indexeltek, és más
  # oldalak is linkelnek rájuk: 301-gyel a legközelebbi új oldalra mennek,
  # így a látogató nem 404-et kap, a Google pedig átviszi a rangsorukat.
  # Az /aquashield-control-projekt/ nincs itt: az valódi oldal maradt.
  RewriteRule ^csapatunk/?$ /rolunk/ [R=301,L]
  RewriteRule ^referenciaink/?$ /munkaink/ [R=301,L]
  RewriteRule ^(szakteruleteink|viz-gaz-futesszereles|napkollektor|csatornazasi-munkak|kozponti-porszivo-rendszer)/?$ /szolgaltatasok/ [R=301,L]
  RewriteRule ^teljes-epuletgepeszet/?$ /szolgaltatasok/komplett-gepeszet/ [R=301,L]
  RewriteRule ^viessmann-kazanok/?$ /szolgaltatasok/egynapos-kazancsere/ [R=301,L]
  RewriteRule ^altalanos-szerzodesi-feltetelek/?$ /aszf/ [R=301,L]
  RewriteRule ^(alternativ-eroforrasok|kornyezettudatossag|energia-megtakaritasi-tippek|finanszirozasi-lehetosegek)/?$ /kell-e-uj-kazan/ [R=301,L]
  RewriteRule ^elerhetoseg/?$ /kapcsolat/ [R=301,L]
  RewriteRule ^gyakori-kerdesek/?$ / [R=301,L]

  # Tartalomszerkesztő: a /keystatic/... címek mind ugyanazt az oldalt töltik
  # be, a szerkesztő maga dönti el, melyik képernyőt mutatja.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^keystatic/ /keystatic/index.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # A /_next/static fájlnevei tartalom szerint változnak, sokáig tárolhatók.
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # A képek a szerkesztőből cserélődhetnek, ezért rövidebb ideig.
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
